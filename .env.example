# Server Configuration
NODE_ENV=development
PORT=5000
ENABLE_SCHEDULER=true
TIMEZONE=America/New_York

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/opportunity_scanner

# SAM.gov API (Register at sam.gov for API key)
SAM_GOV_API_KEY=your_sam_gov_api_key_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com

# Report Recipients (comma-separated)
REPORT_RECIPIENTS=recipient1@company.com,recipient2@company.com

# Opportunity Filter Configuration
MIN_PROJECT_VALUE=100000
MIN_MONITORING_DURATION=3
MAX_DISTANCE_MILES=100
BASE_LATITUDE=40.7128
BASE_LONGITUDE=-74.0060

# Scoring Configuration
AVG_MARGIN_RATE=0.25
RESOURCE_UTILIZATION=0.70
KNOWN_CLIENTS=DOT,MTA,Port Authority

# Logging
LOG_LEVEL=info
